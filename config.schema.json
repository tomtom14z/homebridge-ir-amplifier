{
  "pluginAlias": "IRAmplifier",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "IR Amplifier",
        "description": "Name of the platform in Homebridge"
      },
      "irBackend": {
        "title": "IR Backend",
        "type": "string",
        "default": "auto",
        "oneOf": [
          { "title": "Auto (GPIO puis Broadlink)", "enum": ["auto"] },
          { "title": "GPIO local (ir-ctl / LIRC)", "enum": ["gpio"] },
          { "title": "Broadlink RM Pro", "enum": ["broadlink"] }
        ],
        "description": "Les commandes hex Broadlink existantes sont réutilisées pour l'émetteur GPIO local."
      },
      "gpio": {
        "title": "GPIO / LIRC",
        "type": "object",
        "properties": {
          "device": {
            "title": "Périphérique LIRC",
            "type": "string",
            "default": "/dev/lirc0",
            "description": "Périphérique ir-ctl (gpio-ir-tx)"
          },
          "carrierHz": {
            "title": "Porteuse IR (Hz)",
            "type": "integer",
            "default": 38000,
            "minimum": 30000,
            "maximum": 56000
          }
        }
      },
      "broadlink": {
        "title": "Broadlink Configuration",
        "type": "object",
        "properties": {
          "host": {
            "title": "Broadlink Host",
            "type": "string",
            "format": "ipv4",
            "description": "IP address of your Broadlink RM3 Pro"
          },
          "mac": {
            "title": "Broadlink MAC Address",
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$",
            "description": "MAC address of your Broadlink RM3 Pro"
          },
          "commands": {
            "title": "IR Commands",
            "type": "object",
            "properties": {
              "power": {
                "title": "Power Toggle Command",
                "type": "string",
                "description": "Hex IR command for power toggle (fallback)"
              },
              "powerOn": {
                "title": "Power On Command",
                "type": "string",
                "description": "Hex IR command for power on (optional)"
              },
              "powerOff": {
                "title": "Power Off Command",
                "type": "string",
                "description": "Hex IR command for power off (optional)"
              },
              "source": {
                "title": "Source Toggle Command",
                "type": "string",
                "description": "Hex IR command for source toggle"
              },
              "volumeUp": {
                "title": "Volume Up Command",
                "type": "string",
                "description": "Hex IR command for volume up"
              },
              "volumeDown": {
                "title": "Volume Down Command",
                "type": "string",
                "description": "Hex IR command for volume down"
              },
              "mute": {
                "title": "Mute Command",
                "type": "string",
                "description": "Hex IR command for mute (optional, will use volumeDown if not provided)"
              },
              "menu": {
                "title": "AMP MENU",
                "type": "string"
              },
              "up": {
                "title": "Up",
                "type": "string"
              },
              "down": {
                "title": "Down",
                "type": "string"
              },
              "left": {
                "title": "Left",
                "type": "string"
              },
              "right": {
                "title": "Right",
                "type": "string"
              },
              "enter": {
                "title": "Enter",
                "type": "string"
              }
            },
            "required": ["power", "source", "volumeUp", "volumeDown"]
          }
        },
        "required": ["commands"]
      },
      "volumeInit": {
        "title": "Volume Initialization",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Enable Volume Initialization",
            "type": "boolean",
            "default": false,
            "description": "Enable automatic volume initialization on amplifier power on"
          },
          "maxVolumeSteps": {
            "title": "Maximum Volume Steps",
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum number of volume steps on your amplifier (to ensure we reach minimum)"
          },
          "startupVolume": {
            "title": "Startup Volume Level",
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 7,
            "description": "Absolute volume level to set after initialization (e.g., 7 = volume 7 on amplifier)"
          },
          "delayBetweenSteps": {
            "title": "Delay Between Volume Steps (ms)",
            "type": "integer",
            "minimum": 50,
            "maximum": 1000,
            "default": 200,
            "description": "Delay between each volume command in milliseconds"
          }
        },
        "required": ["enabled", "maxVolumeSteps", "startupVolume", "delayBetweenSteps"]
      },
      "powerOnEnhancements": {
        "title": "Power On Enhancements",
        "type": "object",
        "properties": {
          "autoHDMI1": {
            "title": "Auto Switch to HDMI1",
            "type": "boolean",
            "default": true,
            "description": "Automatically switch TV to HDMI1 via CEC when Apple TV powers on amplifier"
          },
          "tplinkPowerCheck": {
            "title": "TP-Link Power Check",
            "type": "boolean",
            "default": true,
            "description": "Check and ensure TP-Link plug is ON before sending IR commands"
          },
          "tplinkPowerOnDelay": {
            "title": "TP-Link Power On Delay (seconds)",
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 3,
            "description": "Delay after turning on TP-Link plug before sending IR commands"
          }
        },
        "required": ["autoHDMI1", "tplinkPowerCheck", "tplinkPowerOnDelay"]
      },
          "tplink": {
            "title": "TP-Link Configuration",
            "type": "object",
            "properties": {
              "host": {
                "title": "TP-Link Host",
                "type": "string",
                "format": "ipv4",
                "description": "IP address of your TP-Link device"
              }
            },
            "required": ["host"]
          },
          "ocr": {
            "title": "OCR Configuration (Optional)",
            "type": "object",
            "properties": {
              "enabled": {
                "title": "Enable OCR",
                "type": "boolean",
                "default": false,
                "description": "Enable OCR volume detection (requires camera)"
              },
              "backend": {
                "title": "Camera backend",
                "type": "string",
                "default": "http",
                "oneOf": [
                  { "title": "Caméra IP (URL HTTP)", "enum": ["http"] },
                  { "title": "Caméra CSI Raspberry Pi", "enum": ["rpicam"] }
                ],
                "description": "http = snapshot IP. rpicam = caméra CSI du Pi (rpicam-still / libcamera / raspistill)."
              },
              "cameraUrl": {
                "title": "Camera URL",
                "type": "string",
                "format": "uri",
                "description": "URL snapshot si backend=http (ex: http://192.168.1.102:8080/snapshot)"
              },
              "snapshotDir": {
                "title": "Dossier snapshots debug",
                "type": "string",
                "default": "/var/lib/homebridge/ir-amplifier/camera",
                "description": "last.jpg y est écrit à chaque capture"
              },
              "saveSnapshots": {
                "title": "Sauver last.jpg",
                "type": "boolean",
                "default": true
              },
              "debugSnapshots": {
                "title": "Sauver chaque capture horodatée",
                "type": "boolean",
                "default": false
              },
              "width": {
                "title": "Largeur capture CSI",
                "type": "integer",
                "default": 1920,
                "description": "Résolution de sortie après recadrage"
              },
              "height": {
                "title": "Hauteur capture CSI",
                "type": "integer",
                "default": 672
              },
              "roi": {
                "title": "Recadrage afficheur (0–1)",
                "type": "object",
                "description": "Zoom numérique rpicam --roi sur toute la vitre de l'afficheur. x,y,width,height en fraction du capteur.",
                "properties": {
                  "x": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.14 },
                  "y": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.54 },
                  "width": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.84 },
                  "height": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.30 }
                }
              },
              "captureAfterVolumeMs": {
                "title": "Délai après last Volume +/- (ms)",
                "type": "integer",
                "default": 400,
                "minimum": 0,
                "maximum": 2000,
                "description": "Capture uniquement après stabilisation de la rafale. 0 = désactivé. L'afficheur reste ~2s."
              },
              "captureFrames": {
                "title": "Nombre de captures",
                "type": "integer",
                "default": 2,
                "minimum": 1,
                "maximum": 5
              },
              "captureFrameGapMs": {
                "title": "Écart entre captures (ms)",
                "type": "integer",
                "default": 120
              },
              "recognize": {
                "title": "Reconnaissance (Tesseract)",
                "type": "boolean",
                "default": false,
                "description": "Laisser off pour l'instant : photo seule. Templates ensuite."
              },
              "periodic": {
                "title": "Capture périodique",
                "type": "boolean",
                "default": false,
                "description": "Ne pas activer sur Pi 2B"
              },
              "checkInterval": {
                "title": "Check Interval (ms)",
                "type": "number",
                "default": 30000,
                "minimum": 5000,
                "maximum": 300000,
                "description": "Uniquement si periodic=true"
              }
            },
            "required": []
          },
      "cec": {
        "title": "CEC Configuration",
        "type": "object",
        "properties": {
          "deviceName": {
            "title": "CEC Device Name",
            "type": "string",
            "default": "IR Amplifier",
            "description": "Name of the device as it appears in CEC"
          },
          "physicalAddress": {
            "title": "Physical Address",
            "type": "string",
            "default": "1.0.0.0",
            "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$",
            "description": "Physical address for CEC (format: x.x.x.x)"
          },
          "logicalAddress": {
            "title": "Logical Address",
            "type": "number",
            "default": 5,
            "minimum": 0,
            "maximum": 15,
            "description": "Logical address for CEC (0-15)"
          },
          "vendorId": {
            "title": "Vendor ID",
            "type": "string",
            "default": "000000",
            "pattern": "^[0-9A-Fa-f]{6}$",
            "description": "Vendor ID for CEC (6 hex digits)"
          },
          "osdName": {
            "title": "OSD Name",
            "type": "string",
            "default": "IR AMP",
            "description": "Name displayed on screen for CEC"
          }
        },
        "required": ["deviceName", "physicalAddress", "logicalAddress", "vendorId", "osdName"]
      }
    },
        "required": ["name", "broadlink", "tplink", "cec"]
  }
}
