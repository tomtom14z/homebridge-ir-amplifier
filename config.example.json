{
  "platforms": [
    {
      "platform": "IRAmplifier",
      "name": "IR Amplifier",
      "irBackend": "auto",
      "gpio": {
        "device": "/dev/lirc0",
        "carrierHz": 38000
      },
      "broadlink": {
        "host": "192.168.1.100",
        "mac": "AA:BB:CC:DD:EE:FF",
        "commands": {
          "power": "2600500000012a...",
          "source": "2600500000012b...",
          "volumeUp": "2600500000012c...",
          "volumeDown": "2600500000012d...",
          "mute": "2600500000012e..."
        }
      },
      "volumeInit": {
        "enabled": true,
        "maxVolumeSteps": 50,
        "startupVolume": 7,
        "delayBetweenSteps": 200
      },
      "powerOnEnhancements": {
        "autoHDMI1": true,
        "tplinkPowerCheck": true,
        "tplinkPowerOnDelay": 3
      },
      "tplink": {
        "host": "192.168.1.101"
      },
      "ocr": {
        "enabled": false,
        "backend": "rpicam",
        "cameraUrl": "http://192.168.1.102:8080/snapshot",
        "snapshotDir": "/var/lib/homebridge/ir-amplifier/camera",
        "saveSnapshots": true,
        "debugSnapshots": true,
        "width": 1920,
        "height": 672,
        "roi": {
          "x": 0.14,
          "y": 0.54,
          "width": 0.84,
          "height": 0.30
        },
        "captureAfterVolumeMs": 400,
        "captureFrames": 2,
        "captureFrameGapMs": 120,
        "recognize": false,
        "periodic": false
      },
      "cec": {
        "deviceName": "IR Amplifier",
        "physicalAddress": "1.0.0.0",
        "logicalAddress": 5,
        "vendorId": "000000",
        "osdName": "IR AMP"
      }
    }
  ]
}
